if(NOT LIVO_ATLAS_ROS_VERSION STREQUAL "1")
  find_package(GTest REQUIRED)
endif()
function(livo_atlas_test name)
  if(LIVO_ATLAS_ROS_VERSION STREQUAL "1")
    catkin_add_gtest(${name} ${ARGN} tests/test_main.cc)
  else()
    add_executable(${name} ${ARGN} tests/test_main.cc)
    target_link_libraries(${name} GTest::GTest)
    add_test(NAME ${name} COMMAND ${name}
      --gtest_output=xml:${PROJECT_BINARY_DIR}/test_results/${name}.xml)
  endif()
  target_include_directories(${name} PRIVATE ${PROJECT_SOURCE_DIR}/tests)
  target_link_libraries(${name} livo_atlas::core livo_atlas::colorizer livo_atlas::io)
endfunction()
