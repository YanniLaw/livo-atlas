# Compile each public ordinary header as the first and only include.
file(GLOB_RECURSE livo_atlas_public_headers RELATIVE ${PROJECT_SOURCE_DIR}/include
  ${PROJECT_SOURCE_DIR}/include/livo_atlas/*.h)
set(livo_atlas_header_checks)
foreach(header IN LISTS livo_atlas_public_headers)
  if(header MATCHES "/ros[12]/")
    continue()
  endif()
  string(REPLACE "/" "_" name ${header})
  set(source ${PROJECT_BINARY_DIR}/header_checks/${name}.cc)
  file(GENERATE OUTPUT ${source} CONTENT "#include \"${header}\"\n")
  list(APPEND livo_atlas_header_checks ${source})
endforeach()
add_library(livo_atlas_header_checks OBJECT ${livo_atlas_header_checks})
target_link_libraries(livo_atlas_header_checks PRIVATE livo_atlas::core livo_atlas::output livo_atlas::io)

