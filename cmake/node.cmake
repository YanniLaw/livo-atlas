add_executable(fastlivo_mapping src/app/livo_main.cc)
target_compile_definitions(fastlivo_mapping PRIVATE
  LIVO_ATLAS_ROS_VERSION=${LIVO_ATLAS_ROS_VERSION})
if(LIVO_ATLAS_ROS_VERSION STREQUAL "1")
  target_link_libraries(fastlivo_mapping PRIVATE livo_atlas_ros1_node)
  find_package(mimalloc QUIET)
  if(mimalloc_FOUND)
    target_link_libraries(fastlivo_mapping PRIVATE mimalloc)
  endif()
  set(livo_atlas_node_destination ${CATKIN_PACKAGE_BIN_DESTINATION})
else()
  target_link_libraries(fastlivo_mapping PRIVATE livo_atlas_ros2_node)
  set(livo_atlas_node_destination lib/${PROJECT_NAME})
endif()
set_target_properties(fastlivo_mapping PROPERTIES INSTALL_RPATH_USE_LINK_PATH TRUE)
if(UNIX AND NOT APPLE)
  set_target_properties(fastlivo_mapping PROPERTIES INSTALL_RPATH "$ORIGIN/..")
endif()
install(TARGETS fastlivo_mapping RUNTIME DESTINATION ${livo_atlas_node_destination})
