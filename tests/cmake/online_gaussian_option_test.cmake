cmake_minimum_required(VERSION 3.16)
set(option_file "${CMAKE_CURRENT_LIST_DIR}/../../cmake/online_gaussian_option.cmake")

if(DEFINED TEST_REQUEST)
  set(CMAKE_SYSTEM_NAME "${TEST_PLATFORM}")
  set(LIVO_ATLAS_WITH_ONLINE_GAUSSIAN "${TEST_REQUEST}" CACHE STRING "")
  include("${option_file}")
  return()
endif()

function(expect_bridge platform requested expected)
  set(CMAKE_SYSTEM_NAME "${platform}")
  unset(LIVO_ATLAS_WITH_ONLINE_GAUSSIAN CACHE)
  if(NOT requested STREQUAL "default")
    set(LIVO_ATLAS_WITH_ONLINE_GAUSSIAN "${requested}" CACHE BOOL "")
  endif()
  include("${option_file}")
  if(NOT livo_atlas_build_online_gaussian STREQUAL expected)
    message(FATAL_ERROR "Expected ${expected} for ${requested} on ${platform}")
  endif()
  get_property(option_type CACHE LIVO_ATLAS_WITH_ONLINE_GAUSSIAN PROPERTY TYPE)
  if(NOT option_type STREQUAL "STRING")
    message(FATAL_ERROR "The option must accept AUTO in an existing cache")
  endif()
endfunction()

function(expect_error platform requested diagnostic)
  execute_process(COMMAND "${CMAKE_COMMAND}" "-DTEST_REQUEST=${requested}"
    "-DTEST_PLATFORM=${platform}" -P "${CMAKE_CURRENT_LIST_FILE}"
    RESULT_VARIABLE status ERROR_VARIABLE error)
  if(status EQUAL 0 OR NOT error MATCHES "${diagnostic}")
    message(FATAL_ERROR "Unexpected result for ${requested} on ${platform}\n${error}")
  endif()
endfunction()

function(expect_normal_off)
  set(CMAKE_SYSTEM_NAME Linux)
  set(LIVO_ATLAS_WITH_ONLINE_GAUSSIAN OFF)
  include("${option_file}")
  if(livo_atlas_build_online_gaussian)
    message(FATAL_ERROR "An enclosing CMake project's OFF must take precedence")
  endif()
endfunction()

expect_normal_off()
if(DEFINED CACHE{LIVO_ATLAS_WITH_ONLINE_GAUSSIAN})
  message(FATAL_ERROR "A normal variable must not create a cache entry")
endif()
set(LIVO_ATLAS_WITH_ONLINE_GAUSSIAN ON CACHE BOOL "")
expect_normal_off()

expect_bridge(Linux default ON)
expect_bridge(Darwin default OFF)
expect_bridge(Linux ON ON)
expect_bridge(Linux OFF OFF)
expect_bridge(Linux TRUE ON)
expect_bridge(Linux FALSE OFF)
expect_bridge(Linux 2 ON)
expect_bridge(Linux "" OFF)
expect_bridge(Linux NOTFOUND OFF)
expect_error(Darwin ON "requires Linux")
expect_error(Linux MAYBE "must be AUTO, ON or OFF")
